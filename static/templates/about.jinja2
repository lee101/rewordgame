{% extends 'templates/base.jinja2' %}

{% block headers %}

    {% set title = 'About reWord Game - The Word Swapping Puzzle' -%}
    {% set description = 'About reWord Game, a free word puzzle where you drag and swap words until every sentence makes sense.' -%}

        <title>{{ title }}</title>
    <meta name="description"
          content="{{ description }}">

    <meta name="keywords" content="puzzle games, chess rules, instructions, game rules, multiplayer chess game">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="https://rewordgame.v5games.com{{ path }}">
    <meta property="og:image" content="https://rewordgame.v5games.com/static/img/og-reword.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description"
          content="{{ description }}">
    <meta property="og:type" content="game">
    <meta property="og:site_name" content="reWord Game">
    <meta property="fb:admins" content="337972272904903">

{% endblock %}

{% block mainbody %}
    {% include "/templates/shared/about.jinja2" %}
{% endblock %}


