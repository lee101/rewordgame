{% extends 'templates/base.jinja2' %}

{% block headers %}

    {% set title = 'reWord Game - Versus Mode!' -%}
    {% set description = 'Race a friend in reWord Game versus mode: swap the jumbled words into a sensible sentence first to win.' -%}

        <title>{{ title }}</title>
    <meta name="description"
          content="{{ description }}">

    <meta name="keywords" content="puzzle games, chess, online chess, free online puzzle games, multiplayer chess game">
    <meta property="og:title" content="{{ title }}">
    <meta property="og:url" content="https://rewordgame.com{{ path }}">
    <meta property="og:image" content="https://rewordgame.com/static/img/og-reword.png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:description"
          content="{{ description }}">
    <meta property="og:type" content="game">
    <meta property="og:site_name" content="reWord Game">
    <meta property="fb:admins" content="337972272904903">


{% endblock %}

{% block mainbody %}
    {% include "/templates/shared/versus.jinja2" %}
{% endblock %}
